# Секретный ключ Flask (для сессий и CSRF)
SECRET_KEY=autoschool-super-secret-key-change-in-production-2026

# Подключение к базе данных (по умолчанию SQLite, поддерживает PostgreSQL)
DATABASE_URL=sqlite:///autoschool.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoschool_db

# Ключ симметричного шифрования Fernet (32-байтный base64 url-safe ключ)
# Сгенерировать новый ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=W2-F4o_zJ0P4zQY0rU1xN9tH2vK3jL6mS7wE8rT9uI0=

# Секретный ключ для HMAC-SHA256 подписи результатов внутренних экзаменов
HMAC_INTEGRITY_KEY=autoschool-hmac-sha256-exam-integrity-salt-key-2026

# Окружение Flask
FLASK_ENV=development
